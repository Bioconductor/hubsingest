# Values for deploy/cluster/, applied once per cluster:
#
#   set -a; source docs/examples/cluster.env; set +a
#   envsubst < deploy/cluster/10-cluster-issuer.yaml | kubectl apply -f -

# ACME account contact; use a team address
ACME_CONTACT_EMAIL=maintainer@bioconductor.org

# Name of the ingress controller's IngressClass
HUBSINGEST_INGRESS_CLASS=nginx
