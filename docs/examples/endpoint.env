# Values for deploy/endpoint/, one contributor endpoint. Copy this file
# outside the checkout and fill in the two secrets; docs/examples/README.md
# shows the commands.
#
# Cluster and image values are the defaults of the scripts.

# Contributor: lowercase; the namespace prefix, DNS label and S3 access key
HUBSINGEST_USER=dataowner
HUBSINGEST_SIZE=50Gi
# openssl rand -hex 32; the S3KEY_<USERNAME> repository secret
HUBSINGEST_SECRET_KEY=

# Cluster
HUBSINGEST_DOMAIN=hubsingest.bioconductor.org
HUBSINGEST_INGRESS_CLASS=nginx
HUBSINGEST_CLUSTER_ISSUER=letsencrypt-prod
HUBSINGEST_STORAGE_CLASS=ebs
HUBSINGEST_MAX_BODY_SIZE=10g

# Images
HUBSINGEST_VERSITYGW_IMAGE=ghcr.io/versity/versitygw:v1.7.0
HUBSINGEST_BIOC_VERSION=3.23

# 60-rstudio.yaml only: the admin's ADMINPASS_<GITHUB-USERNAME> value
HUBSINGEST_RSTUDIO_PASSWORD=
